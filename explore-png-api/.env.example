# Runtime environment
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/explore_png_db?schema=public

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# error | warn | log | debug | verbose
LOG_LEVEL=log

# Secret used to protect driver location endpoints.
# Use at least 32 random characters and never commit the real value.
